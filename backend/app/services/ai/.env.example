# Backend environment only; select a text/image and structured-output capable model.
GEMINI_API_KEY=
GEMINI_MODEL=

# gemini (default) or ollama
AI_PROVIDER=gemini
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_BASE_URL=http://localhost:11434
# Only required for direct cloud: OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=

# Native desktop action selection uses authenticated cf CLI (no Wrangler project).
# Set only when cf is not on PATH; may be a cf executable, .cmd or .ps1 launcher.
CF_EXECUTABLE=
